{
  "name": "computer-organization-quiz",
  "version": "1.0.0",
  "description": "计算机组成原理 350 题练习（多主题）",
  "main": "main.js",
  "scripts": {
    "dev": "electron .",
    "build": "electron-builder",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux"
  },
  "build": {
    "appId": "com.yake.computer-organization-quiz",
    "productName": "Computer Organization Quiz",
    "directories": { "output": "dist" },
    "files": [
      "main.js",
      "preload.js",
      "menu.js",
      "window-state.js",
      "unified/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "mac": {
      "target": "dmg",
      "icon": "assets/icon.png",
      "category": "public.app-category.education"
    },
    "linux": {
      "target": "AppImage",
      "icon": "assets/icon.png"
    }
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.0"
  }
}
