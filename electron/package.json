{
  "name": "computer-organization-quiz",
  "version": "1.0.0",
  "description": "计算机组成原理 350 题练习（多主题）",
  "author": "yake <yake2024@163.com>",
  "main": "main.js",
  "scripts": {
    "dev": "electron-reload . --unrestricted",
    "dev:classic": "electron .",
    "build": "electron-builder",
    "build:win": "electron-builder --win --publish never",
    "build:mac": "electron-builder --mac --publish never",
    "build:linux": "electron-builder --linux --publish never",
    "release": "node scripts/publish-gitee.js",
    "release:manual": "electron-builder --win"
  },
  "build": {
    "appId": "com.yake.computer-organization-quiz",
    "productName": "Computer Organization Quiz",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "menu.js",
      "window-state.js",
      "unified/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "target": [
		{ "target": "nsis", "arch": ["x64"] },
		{ "target": "portable", "arch": ["x64"] },
		{ "target": "zip", "arch": ["x64"] }
      ]
      "icon": "assets/icon.ico"
    },
    "mac": {
      "target": "dmg",
      "icon": "assets/icon.png",
      "category": "public.app-category.education"
    },
    "linux": {
      "target": "AppImage",
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    },
    "publish": {
      "provider": "generic",
      "url": "https://gitee.com/yake2024/computer-organization-quiz/releases/latest/download/"
    }
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.0",
    "electron-reload": "^2.0.0-alpha.1"
  },
  "dependencies": {
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.9"
  }
}
