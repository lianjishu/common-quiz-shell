{
  "name": "quiz-shell",
  "version": "1.3.0",
  "description": "多科目复习题库：计算机组成原理 350 题 + JavaWeb 期末 195 题（5 套主题）",
  "author": "yake <yake2024@163.com>",
  "main": "src/main/index.js",
  "scripts": {
    "dev": "electron .",
    "postinstall": "node scripts/ensure-electron.js",
    "build": "electron-builder",
    "check": "python tools/check_consistency.py",
    "build:win": "electron-builder --win --publish never",
    "build:mac": "electron-builder --mac --publish never",
    "build:linux": "electron-builder --linux --publish never",
    "release": "node build/publish-gitee.js",
    "release:manual": "electron-builder --win"
  },
  "build": {
    "appId": "com.yake.quiz-shell",
    "productName": "QuizShell",
    "directories": {
      "output": "dist"
    },
    "files": [
      "index.html",
      "shared/**/*",
      "subjects/**/*",
      "src/main/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico"
    },
    "mac": {
      "target": "dmg",
      "icon": "assets/icon.png",
      "category": "public.app-category.education"
    },
    "linux": {
      "target": "AppImage",
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    },
    "publish": {
      "provider": "generic",
      "url": "https://gitee.com/yake2024/quiz-shell/releases/download/latest/"
    }
  },
  "devDependencies": {
    "electron": "^31.7.7",
    "electron-builder": "^24.13.0",
    "electron-reload": "^2.0.0-alpha.1"
  },
  "dependencies": {
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.9"
  }
}
